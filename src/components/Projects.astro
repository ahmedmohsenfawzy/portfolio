---
import ProjectCard from './ProjectCard.astro';
import { PROJECTS } from '../data/portfolio-data';

const categories = ['All', ...new Set(PROJECTS.map((project) => project.category))];
---

<section id="projects" class="px-5 sm:px-10 lg:px-14 py-12 md:py-16">
  <div class="w-full max-w-[1180px] mx-auto grid grid-cols-1 xl:grid-cols-12 gap-8 xl:gap-10 items-start">
    <div class="xl:col-span-4 xl:sticky xl:top-8">
      <p class="page-tags" aria-hidden="true">&lt;h1&gt;</p>
      <h1 class="font-display text-5xl sm:text-6xl lg:text-[4rem] text-accent mb-2 leading-none">Projects</h1>
      <p class="page-tags mb-6" aria-hidden="true">&lt;/h1&gt;</p>
      <p class="text-white text-[15px] sm:text-base leading-relaxed font-light">
        A showcase of data engineering work across streaming platforms, medallion warehouses, dbt analytics, and SSIS dimensional models. Each card links to the matching GitHub repository.
      </p>
      <div class="flex flex-wrap gap-2 mt-6" data-filter-bar>
        {categories.map((category) => (
          <button
            type="button"
            class:list={['filter-btn', category === 'All' && 'active']}
            data-filter={category}
          >
            {category}
          </button>
        ))}
      </div>
    </div>

    <div class="xl:col-span-8 xl:max-h-[78vh] xl:overflow-y-auto projects-scroll pr-1">
      <div class="grid grid-cols-1 gap-6" data-projects-grid>
        {PROJECTS.map((project) => (
          <div data-category={project.category}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('[data-filter]');
  const cards = document.querySelectorAll('[data-category]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter') ?? 'All';
      buttons.forEach((item) => item.classList.toggle('active', item === button));
      cards.forEach((card) => {
        const show = filter === 'All' || card.getAttribute('data-category') === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
