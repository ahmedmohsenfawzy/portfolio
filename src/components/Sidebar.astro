---
import Icon from './icons/Icon.astro';
import { PERSONAL_INFO } from '../data/portfolio-data';

const navItems = [
  { label: 'HOME', href: '/', icon: 'home' },
  { label: 'ABOUT', href: '/about', icon: 'user' },
  { label: 'PROJECTS', href: '/projects', icon: 'briefcase' },
  { label: 'SKILLS', href: '/skills', icon: 'wrench' },
  { label: 'JOURNEY', href: '/certifications', icon: 'award' },
  { label: 'CONTACT', href: '/contact', icon: 'mail' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<aside class="hidden md:flex fixed top-0 left-0 h-screen w-[80px] flex-col items-center justify-between py-5 z-50 bg-ink">
  <a href="/" class="flex flex-col items-center gap-1" aria-label="Home">
    <span class="text-3xl font-display text-accent leading-none">A</span>
    <span class="text-[9px] tracking-[0.18em] text-slate-400">AHMED</span>
  </a>

  <nav class="flex flex-col items-center w-full" aria-label="Main Navigation">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          data-label={item.label}
          class:list={['nav-link flex items-center justify-center w-full h-[56px]', isActive && 'text-gold']}
          aria-current={isActive ? 'page' : undefined}
          title={item.label}
        >
          <Icon name={item.icon} size={28} class="w-7 h-7" />
        </a>
      );
    })}
  </nav>

  <ul class="flex flex-col items-center gap-3 list-none p-0 m-0">
    <li>
      <a href={PERSONAL_INFO.linkedin.url} target="_blank" rel="noopener noreferrer" class="text-[#4d4d4e] hover:text-gold" aria-label="LinkedIn">
        <Icon name="linkedin" size={22} class="w-6 h-6" />
      </a>
    </li>
    <li>
      <a href={PERSONAL_INFO.github.url} target="_blank" rel="noopener noreferrer" class="text-[#4d4d4e] hover:text-gold" aria-label="GitHub">
        <Icon name="github" size={22} class="w-6 h-6" />
      </a>
    </li>
  </ul>
</aside>

<header class="md:hidden fixed top-0 left-0 right-0 z-50 h-16 flex items-center justify-between px-4 bg-ink/95 border-b border-white/10">
  <a href="/" class="flex items-center gap-2">
    <span class="text-2xl font-display text-accent leading-none">A</span>
    <span class="text-xs tracking-[0.2em] text-slate-300">AHMED</span>
  </a>
  <button
    id="mobile-menu-btn"
    type="button"
    class="p-2 text-slate-300 hover:text-accent"
    aria-label="Toggle navigation menu"
    aria-expanded="false"
    aria-controls="mobile-menu-drawer"
  >
    <Icon name="menu" size={22} />
  </button>
</header>

<div id="mobile-menu-drawer" class="hidden md:hidden fixed inset-x-0 top-16 z-40 bg-ink/98 border-b border-white/10 px-6 py-6">
  <nav class="flex flex-col gap-1" aria-label="Mobile Navigation">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class:list={['mobile-nav-link flex items-center gap-3 py-3 border-b border-white/10', isActive ? 'text-accent' : 'text-slate-200']}
        >
          <Icon name={item.icon} size={18} />
          <span>{item.label}</span>
        </a>
      );
    })}
  </nav>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-menu-drawer');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (btn && drawer) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      drawer.classList.toggle('hidden');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        drawer.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.classList.contains('hidden')) {
        drawer.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
