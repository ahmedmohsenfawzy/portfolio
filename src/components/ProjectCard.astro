---
import Icon from './icons/Icon.astro';
import type { Project } from '../data/portfolio-data';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card reveal-on-scroll">
  <div class="p-6 sm:p-7">
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="px-3 py-1 rounded-full text-[11px] uppercase tracking-wide bg-accent/20 text-accent">{project.category}</span>
      <span class="px-3 py-1 rounded-full text-[11px] bg-orange-500/20 text-[#ff4500]">{project.year}</span>
      <span class="px-3 py-1 rounded-full text-[11px] uppercase tracking-wide bg-emerald-500/20 text-emerald-300">{project.badge}</span>
    </div>

    <a
      href={project.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="project-title-row group"
    >
      <h3 class="font-display text-2xl sm:text-3xl text-white group-hover:text-accent transition-colors">{project.title}</h3>
      <span class="project-title-line" aria-hidden="true"></span>
      <span class="shrink-0 text-accent group-hover:text-[#ff4500] transition-colors" aria-label="Open GitHub repository">
        <Icon name="github" size={18} />
      </span>
    </a>
    <p class="text-sm text-accent mt-1">{project.subtitle}</p>

    <p class="text-sm text-slate-300 leading-relaxed mt-4">{project.problem}</p>

    <div class="mt-5">
      <h4 class="text-sm font-semibold text-white mb-2">Key Features</h4>
      <ul class="space-y-1.5">
        {project.architectureDetails.slice(0, 4).map((detail) => (
          <li class="text-[13px] text-slate-400 flex items-start gap-2">
            <span class="text-accent mt-0.5">●</span>
            <span>{detail}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-wrap gap-2 mt-5">
      {project.tools.slice(0, 8).map((tool) => (
        <span class="px-2.5 py-1 rounded-full text-[11px] bg-white/10 border border-white/20 text-slate-100">{tool}</span>
      ))}
    </div>

    <a
      href={project.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 mt-5 text-sm text-accent hover:text-[#ff4500]"
    >
      <Icon name="github" size={16} />
      Code
      <Icon name="external-link" size={12} />
    </a>
  </div>
</article>
