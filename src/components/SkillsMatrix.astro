---
import Icon from './icons/Icon.astro';
import { SKILL_GROUPS } from '../data/portfolio-data';
---

<section id="skills" class="py-20 bg-slate-950/40 relative border-t border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="max-w-3xl mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-cyan-950/80 border border-cyan-500/30 text-cyan-300 font-mono text-xs">
        <Icon name="cpu" size={14} />
        <span>TECHNICAL CAPABILITIES</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Engineering Skills & <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400">Tech Stack</span>
      </h2>
      <p class="text-slate-400 text-base">
        A breakdown of my end-to-end data stack across cloud warehousing, distributed streaming, pipeline orchestration, dimensional modeling, and developer tooling.
      </p>
    </div>

    <!-- Skills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {SKILL_GROUPS.map((group) => (
        <div class="glass-card rounded-2xl p-6 border border-slate-800 flex flex-col justify-between reveal-on-scroll">
          <div>
            <!-- Group Header -->
            <div class="flex items-center gap-3 pb-4 mb-4 border-b border-slate-800/80">
              <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-700/60 text-cyan-400">
                <Icon name={group.icon} size={20} />
              </div>
              <div>
                <h3 class="text-base font-bold text-white">{group.category}</h3>
                <p class="text-xs text-slate-400">{group.description}</p>
              </div>
            </div>

            <!-- Skill Badges -->
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-900/90 border border-slate-700/70 text-xs font-mono text-slate-200">
                  {skill.level === 'Core' && (
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-400" title="Core Strength"></span>
                  )}
                  {skill.level === 'Proficient' && (
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" title="Proficient"></span>
                  )}
                  {skill.level === 'Familiar' && (
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-500" title="Familiar"></span>
                  )}
                  <span>{skill.name}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Legend helper -->
          <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between text-[10px] font-mono text-slate-400">
            <span>Verified Experience</span>
            <span class="text-cyan-400">Production Tested</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Legend bar -->
    <div class="mt-8 p-4 rounded-xl bg-slate-900/50 border border-slate-800 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-slate-400">
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span> Core Specialty
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Proficient
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-slate-500"></span> Familiar
        </span>
      </div>
      <div class="text-slate-400">
        Strictly aligned with verified project deliverables & certifications.
      </div>
    </div>

  </div>
</section>
