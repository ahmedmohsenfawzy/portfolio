---
import { PERSONAL_INFO } from '../data/portfolio-data';
---

<section class="px-5 sm:px-10 lg:px-14 py-12 md:py-16">
  <div class="max-w-[1180px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <div class="lg:col-span-7 space-y-5">
      <p class="page-tags" aria-hidden="true">&lt;h1&gt;</p>
      <h1 class="font-display text-5xl sm:text-6xl lg:text-[4rem] text-accent leading-none">About</h1>
      <p class="page-tags" aria-hidden="true">&lt;/h1&gt;</p>

      <p class="text-white text-[15px] sm:text-base leading-relaxed max-w-xl font-light">{PERSONAL_INFO.summary}</p>
      <p class="text-white text-[15px] sm:text-base leading-relaxed max-w-xl font-light">
        Based in {PERSONAL_INFO.location}. I build production-minded pipelines: Kafka fanout, Snowflake Medallion layers, ClickHouse OLAP, and analytics engineering with dbt and Dagster.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4">
        {PERSONAL_INFO.stats.map((stat) => (
          <div class="glass-card rounded-xl p-4">
            <div class="text-[11px] tracking-widest uppercase text-accent">{stat.label}</div>
            <div class="mt-1 text-sm text-white">{stat.value}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="lg:col-span-5 flex justify-center">
      <div class="stage-cube" aria-hidden="true">
        <div class="cubespinner">
          <div class="face1">Python</div>
          <div class="face2">SQL</div>
          <div class="face3">Kafka</div>
          <div class="face4">Snowflake</div>
          <div class="face5">dbt</div>
          <div class="face6">Airflow</div>
        </div>
      </div>
    </div>
  </div>
</section>
