---
import Icon from './icons/Icon.astro';
---

<section id="architecture" class="py-20 bg-slate-950/60 relative border-t border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-cyan-950/80 border border-cyan-500/30 text-cyan-300 font-mono text-xs">
        <Icon name="layers" size={14} />
        <span>SYSTEM DESIGN & DATA FLOW</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Interactive Architecture: <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400">Sky Eye Dual Pipeline</span>
      </h2>
      <p class="text-slate-400 text-base leading-relaxed">
        Live ADS-B flight telemetry streams at massive volumes. Here is how I architected the dual streaming and batch platform, unifying real-time sub-second anomaly detection with an immutable Medallion warehouse.
      </p>
    </div>

    <!-- Interactive Architecture Canvas -->
    <div class="glass-card rounded-2xl p-6 lg:p-8 border border-slate-700/80 shadow-2xl relative overflow-hidden">
      
      <!-- Top Architecture Controls / View Tabs -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-800">
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Architecture Views">
          <button 
            type="button" 
            role="tab" 
            aria-selected="true" 
            aria-controls="view-dual"
            id="tab-dual"
            class="arch-tab-btn active px-4 py-2 rounded-lg text-xs font-mono font-medium transition-all bg-cyan-500/20 text-cyan-300 border border-cyan-500/40"
          >
            Unified Dual-Pipeline
          </button>
          <button 
            type="button" 
            role="tab" 
            aria-selected="false" 
            aria-controls="view-streaming"
            id="tab-streaming"
            class="arch-tab-btn px-4 py-2 rounded-lg text-xs font-mono font-medium transition-all bg-slate-900/80 text-slate-400 border border-slate-800 hover:text-white"
          >
            Real-Time Streaming Fanout
          </button>
          <button 
            type="button" 
            role="tab" 
            aria-selected="false" 
            aria-controls="view-medallion"
            id="tab-medallion"
            class="arch-tab-btn px-4 py-2 rounded-lg text-xs font-mono font-medium transition-all bg-slate-900/80 text-slate-400 border border-slate-800 hover:text-white"
          >
            Medallion Warehouse (Bronze/Silver/Gold)
          </button>
        </div>

        <div class="flex items-center gap-3 text-xs font-mono text-slate-400">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span> Streaming
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Warehouse / ML
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span> Batch
          </span>
        </div>
      </div>

      <!-- VIEW 1: UNIFIED DUAL-PIPELINE -->
      <div id="view-dual" class="arch-view py-6 space-y-8" role="tabpanel" aria-labelledby="tab-dual">
        
        <!-- Stream Track Flow -->
        <div class="space-y-2">
          <div class="text-xs font-mono text-cyan-400 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>TRACK 1: STREAMING PIPELINE (LOW-LATENCY ALERTS & OLAP)</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-stretch">
            <!-- Node 1: Ingestion -->
            <div class="p-4 rounded-xl bg-slate-900/90 border border-cyan-500/30 flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-cyan-400 uppercase">Ingestion API</div>
                <div class="text-sm font-bold text-white mt-1">OpenSky Network API</div>
                <p class="text-xs text-slate-400 mt-1">Continuous REST/WebSocket stream of live ADS-B flight transponders.</p>
              </div>
              <div class="mt-4 pt-2 border-t border-slate-800 text-[11px] font-mono text-slate-400">
                Protocol: JSON Streams
              </div>
            </div>

            <!-- Node 2: Kafka Buffer -->
            <div class="p-4 rounded-xl bg-slate-900/90 border border-cyan-500/30 flex flex-col justify-between relative">
              <div>
                <div class="text-[10px] font-mono text-cyan-400 uppercase">Message Broker</div>
                <div class="text-sm font-bold text-white mt-1">Apache Kafka</div>
                <p class="text-xs text-slate-400 mt-1">Decoupled pub/sub topic partitioned for high-throughput consumer parallel fanout.</p>
              </div>
              <div class="mt-4 pt-2 border-t border-slate-800 text-[11px] font-mono text-emerald-400">
                2 Parallel Consumers
              </div>
            </div>

            <!-- Node 3: ClickHouse OLAP -->
            <div class="p-4 rounded-xl bg-slate-900/90 border border-cyan-500/30 flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-cyan-400 uppercase">Real-Time OLAP</div>
                <div class="text-sm font-bold text-white mt-1">ClickHouse DB</div>
                <p class="text-xs text-slate-400 mt-1">Sub-second analytical queries on flight paths, delays, and telemetry.</p>
              </div>
              <div class="mt-4 pt-2 border-t border-slate-800 text-[11px] font-mono text-cyan-300">
                Latency: &lt;14ms queries
              </div>
            </div>

            <!-- Node 4: Grafana Live Monitoring -->
            <div class="p-4 rounded-xl bg-slate-900/90 border border-cyan-500/30 flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-cyan-400 uppercase">Observability & Alerts</div>
                <div class="text-sm font-bold text-white mt-1">Grafana Dashboards</div>
                <p class="text-xs text-slate-400 mt-1">Real-time alert notifications, flight trajectory anomalies, and spatial maps.</p>
              </div>
              <div class="mt-4 pt-2 border-t border-slate-800 text-[11px] font-mono text-slate-400">
                Real-Time Refresh: 1s
              </div>
            </div>
          </div>
        </div>

        <!-- Divider with Data Confluence -->
        <div class="relative py-2 text-center">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-slate-800"></div>
          </div>
          <span class="relative px-3 bg-slate-900 border border-slate-700 text-[11px] font-mono text-slate-300 rounded-full">
            UNIFIED WAREHOUSE CORE: SNOWFLAKE
          </span>
        </div>

        <!-- Batch Track Flow -->
        <div class="space-y-2">
          <div class="text-xs font-mono text-amber-400 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>TRACK 2: BATCH MEDALLION PIPELINE (HISTORICAL ANALYTICS & ML SCORING)</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-stretch">
            <!-- Node 1: Historical Ingestion -->
            <div class="p-4 rounded-xl bg-slate-900/90 border border-amber-500/30 flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-amber-400 uppercase">Storage Ingestion</div>
                <div class="text-sm font-bold text-white mt-1">AWS S3 / MinIO Lake</div>
                <p class="text-xs text-slate-400 mt-1">Bulk historical ADS-B archives ingested from source repositories.</p>
              </div>
              <div class="mt-4 pt-2 border-t border-slate-800 text-[11px] font-mono text-slate-400">
                Format: Raw Parquet / CSV
              </div>
            </div>

            <!-- Node 2: Snowflake Bronze -->
            <div class="p-4 rounded-xl bg-slate-900/90 border border-amber-500/30 flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-amber-400 uppercase">Bronze Layer</div>
                <div class="text-sm font-bold text-white mt-1">Snowflake Bronze</div>
                <p class="text-xs text-slate-400 mt-1">Immutable raw state preserving full historical fidelity without data loss.</p>
              </div>
              <div class="mt-4 pt-2 border-t border-slate-800 text-[11px] font-mono text-amber-300">
                Raw Audit Preservation
              </div>
            </div>

            <!-- Node 3: Snowflake Silver -->
            <div class="p-4 rounded-xl bg-slate-900/90 border border-slate-700 flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-slate-300 uppercase">Silver Layer</div>
                <div class="text-sm font-bold text-white mt-1">Snowflake Silver</div>
                <p class="text-xs text-slate-400 mt-1">Type casting, null filling, schema validation, and business rule alignment.</p>
              </div>
              <div class="mt-4 pt-2 border-t border-slate-800 text-[11px] font-mono text-cyan-400">
                100% Quality Validated
              </div>
            </div>

            <!-- Node 4: Snowflake Gold & BI -->
            <div class="p-4 rounded-xl bg-slate-900/90 border border-emerald-500/30 flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-emerald-400 uppercase">Gold Layer & BI</div>
                <div class="text-sm font-bold text-white mt-1">Star Schema + Power BI</div>
                <p class="text-xs text-slate-400 mt-1">fact_flights with route, airport & aircraft dimensions + ML anomaly scoring.</p>
              </div>
              <div class="mt-4 pt-2 border-t border-slate-800 text-[11px] font-mono text-emerald-300">
                Executive BI + ML Scores
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- VIEW 2: STREAMING FANOUT DEEP-DIVE -->
      <div id="view-streaming" class="arch-view hidden py-6 space-y-6" role="tabpanel" aria-labelledby="tab-streaming">
        <div class="p-4 rounded-xl bg-slate-900/60 border border-cyan-500/20 text-slate-300 text-sm">
          <span class="font-semibold text-cyan-300 font-mono">Fanout Pattern:</span>
          A single Kafka topic partitions live flight state vectors, allowing two independent consumer groups to read concurrently without mutual blocking or lag interference.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-5 rounded-xl bg-slate-900 border border-slate-800 space-y-3">
            <div class="flex items-center gap-2 text-cyan-400 font-mono text-sm font-bold">
              <span class="p-1 rounded bg-cyan-950 border border-cyan-800/40">Consumer 1</span>
              <span>Lakehouse & ML Scoring Track</span>
            </div>
            <ul class="text-xs text-slate-300 space-y-2 list-disc list-inside">
              <li>Lands raw json events into MinIO object-store bucket for cold replayability.</li>
              <li>Promotes batches to Snowflake stage via snowpipe/copy patterns.</li>
              <li>Runs near real-time ML anomaly detection scoring models on telemetry attributes.</li>
              <li>Stores anomaly inference outcomes back into the analytics repository.</li>
            </ul>
          </div>

          <div class="p-5 rounded-xl bg-slate-900 border border-slate-800 space-y-3">
            <div class="flex items-center gap-2 text-emerald-400 font-mono text-sm font-bold">
              <span class="p-1 rounded bg-emerald-950 border border-emerald-800/40">Consumer 2</span>
              <span>Sub-Second OLAP & Alert Track</span>
            </div>
            <ul class="text-xs text-slate-300 space-y-2 list-disc list-inside">
              <li>Applies lightweight stream deduplication and coordinate bounding.</li>
              <li>Writes directly to ClickHouse columnar tables using vectorized batch inserts.</li>
              <li>Powers instant Grafana geospatial and delay-trend dashboards.</li>
              <li>Sub-second query response time allows live flight dispatchers to monitor anomalies.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- VIEW 3: MEDALLION WAREHOUSE DEEP-DIVE -->
      <div id="view-medallion" class="arch-view hidden py-6 space-y-6" role="tabpanel" aria-labelledby="tab-medallion">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- Bronze Card -->
          <div class="p-5 rounded-xl bg-slate-900 border border-amber-500/40 space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-xs font-mono font-bold text-amber-400 uppercase">Bronze Layer</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-950 text-amber-300">IMMUTABLE</span>
            </div>
            <h3 class="text-base font-bold text-white">Raw Source Ingestion</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Preserves the exact raw format from sources (S3, GitHub datasets, CRM/ERP). Stored procedures run incremental or bulk append without modifying business logic.
            </p>
            <div class="pt-2 border-t border-slate-800 text-[11px] font-mono text-slate-400">
              Pattern: Append-only raw tables
            </div>
          </div>

          <!-- Silver Card -->
          <div class="p-5 rounded-xl bg-slate-900 border border-slate-700 space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-xs font-mono font-bold text-slate-300 uppercase">Silver Layer</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-200">CONFORMED</span>
            </div>
            <h3 class="text-base font-bold text-white">Cleansed & Enriched</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Normalizes datatypes, handles null imputation, dedupes records, and calculates derived columns using window functions (e.g. <code class="text-cyan-300">LEAD()</code> for valid end dates).
            </p>
            <div class="pt-2 border-t border-slate-800 text-[11px] font-mono text-cyan-300">
              Automated Data Quality Tests
            </div>
          </div>

          <!-- Gold Card -->
          <div class="p-5 rounded-xl bg-slate-900 border border-emerald-500/40 space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-xs font-mono font-bold text-emerald-400 uppercase">Gold Layer</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-300">BUSINESS MARTS</span>
            </div>
            <h3 class="text-base font-bold text-white">Star Schema & ML Ready</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Exposes consumption views: dimension tables (<code class="text-slate-200">dim_customers</code>, <code class="text-slate-200">dim_products</code>, <code class="text-slate-200">dim_routes</code>) joined to aggregated fact tables (<code class="text-slate-200">fact_sales</code>, <code class="text-slate-200">fact_flights</code>) for high-performance Power BI reporting.
            </p>
            <div class="pt-2 border-t border-slate-800 text-[11px] font-mono text-emerald-300">
              Optimized for BI & Feature Stores
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll('.arch-tab-btn');
  const views = document.querySelectorAll('.arch-view');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => {
        b.classList.remove('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
        b.classList.add('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('active', 'bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40');
      btn.classList.remove('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
      btn.setAttribute('aria-selected', 'true');

      const targetId = btn.getAttribute('aria-controls');
      views.forEach(v => {
        if (v.id === targetId) {
          v.classList.remove('hidden');
        } else {
          v.classList.add('hidden');
        }
      });
    });
  });
</script>
