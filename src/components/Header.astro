---
import Icon from './icons/Icon.astro';
import { PERSONAL_INFO } from '../data/portfolio-data';

const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Architecture', href: '#architecture' },
  { label: 'Projects', href: '#projects' },
  { label: 'Skills', href: '#skills' },
  { label: 'Certifications', href: '#certifications' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#" class="group flex items-center gap-2 font-mono text-sm sm:text-base font-bold text-white tracking-wider focus:outline-none focus:ring-2 focus:ring-cyan-400 rounded-md p-1">
      <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 shadow-[0_0_10px_#38bdf8] group-hover:scale-125 transition-transform"></span>
      <span class="text-cyan-400">AT</span><span class="text-slate-400">/</span><span class="text-slate-200">DATA_ENG</span>
      <span class="animate-pulse text-cyan-400">_</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6" aria-label="Main Navigation">
      {navItems.map((item) => (
        <a 
          href={item.href}
          class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors py-1 focus:outline-none focus:ring-2 focus:ring-cyan-400/50 rounded"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Status Badge -->
      <div class="hidden xl:flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-emerald-400 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Open to Opportunities</span>
      </div>

      <!-- GitHub -->
      <a 
        href={PERSONAL_INFO.github.url} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="p-2 text-slate-400 hover:text-white hover:bg-slate-800/60 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-400"
        aria-label="GitHub Profile"
      >
        <Icon name="github" size={18} />
      </a>

      <!-- LinkedIn -->
      <a 
        href={PERSONAL_INFO.linkedin.url} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="p-2 text-slate-400 hover:text-cyan-400 hover:bg-slate-800/60 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-400"
        aria-label="LinkedIn Profile"
      >
        <Icon name="linkedin" size={18} />
      </a>

      <!-- Direct Contact CTA -->
      <a 
        href="#contact" 
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-mono font-semibold text-slate-950 bg-cyan-400 hover:bg-cyan-300 transition-all shadow-[0_0_15px_rgba(56,189,248,0.25)] focus:outline-none focus:ring-2 focus:ring-cyan-300"
      >
        <span>Get in Touch</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 text-slate-400 hover:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-400"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu-drawer"
    >
      <Icon name="menu" size={22} />
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div 
    id="mobile-menu-drawer" 
    class="hidden md:hidden fixed inset-x-0 top-16 bg-slate-950/95 border-b border-slate-800 backdrop-blur-xl px-6 py-6 transition-all duration-300"
  >
    <nav class="flex flex-col gap-4">
      {navItems.map((item) => (
        <a 
          href={item.href}
          class="mobile-nav-link text-base font-medium text-slate-200 hover:text-cyan-400 transition-colors py-2 border-b border-slate-800/40"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-4 flex flex-col gap-3">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-emerald-400 text-xs font-mono w-fit">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Open to Opportunities</span>
        </div>
        <div class="flex items-center gap-4 pt-2">
          <a href={PERSONAL_INFO.github.url} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-white flex items-center gap-2 text-sm">
            <Icon name="github" size={18} />
            <span>GitHub</span>
          </a>
          <a href={PERSONAL_INFO.linkedin.url} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-cyan-400 flex items-center gap-2 text-sm">
            <Icon name="linkedin" size={18} />
            <span>LinkedIn</span>
          </a>
        </div>
        <a 
          href="#contact" 
          class="mobile-nav-link mt-2 text-center py-2.5 rounded-lg text-sm font-mono font-semibold text-slate-950 bg-cyan-400"
        >
          Contact Ahmed
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-menu-drawer');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (btn && drawer) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      drawer.classList.toggle('hidden');
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.classList.contains('hidden')) {
        drawer.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
