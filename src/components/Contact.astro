---
import Icon from './icons/Icon.astro';
import { PERSONAL_INFO, LANGUAGES_AND_SOFT_SKILLS } from '../data/portfolio-data';
---

<section id="contact" class="px-5 sm:px-10 lg:px-14 py-11 md:py-14 text-[15px]">
  <div class="max-w-[1180px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-7 items-start">
    <div class="lg:col-span-5 space-y-4">
      <p class="page-tags" aria-hidden="true">&lt;h1&gt;</p>
      <h1 class="font-display text-[2.75rem] sm:text-[3.5rem] lg:text-[calc(4rem-4px)] text-accent leading-none">Contact</h1>
      <p class="page-tags" aria-hidden="true">&lt;/h1&gt;</p>
      <p class="text-slate-200 leading-relaxed text-[15px]">
        I am open to Data Engineering roles building streaming platforms, Medallion warehouses, and analytics pipelines.
      </p>

      <div class="space-y-2.5">
        <a href={`mailto:${PERSONAL_INFO.email}`} class="flex items-center gap-2.5 text-white hover:text-accent">
          <Icon name="mail" size={16} />
          <span class="font-mono text-[13px]">{PERSONAL_INFO.email}</span>
        </a>
        <a href={`tel:${PERSONAL_INFO.phone.replace(/\s+/g, '')}`} class="flex items-center gap-2.5 text-white hover:text-accent">
          <Icon name="phone" size={16} />
          <span class="font-mono text-[13px]">{PERSONAL_INFO.phone}</span>
        </a>
        <p class="flex items-center gap-2.5 text-slate-300 text-[15px]">
          <Icon name="map-pin" size={16} class="text-accent" />
          <span>{PERSONAL_INFO.location}</span>
        </p>
      </div>

      <div class="flex flex-wrap gap-1.5">
        {LANGUAGES_AND_SOFT_SKILLS.languages.map((lang) => (
          <span class="px-2 py-0.5 rounded border border-accent/30 text-[11px]">
            {lang.language} · {lang.proficiency}
          </span>
        ))}
      </div>
    </div>

    <div class="lg:col-span-7 space-y-5">
      <form
        class="glass-card rounded-2xl p-5 space-y-3"
        action={`https://formsubmit.co/${PERSONAL_INFO.email}`}
        method="POST"
      >
        <input type="hidden" name="_subject" value="Portfolio contact" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

        <label class="block">
          <span class="sr-only">Name</span>
          <input
            required
            type="text"
            name="name"
            placeholder="Name"
            class="w-full bg-transparent border-b border-white/20 focus:border-accent outline-none py-2.5 text-[15px] text-white placeholder:text-slate-500"
          />
        </label>
        <label class="block">
          <span class="sr-only">Email</span>
          <input
            required
            type="email"
            name="email"
            placeholder="Email"
            class="w-full bg-transparent border-b border-white/20 focus:border-accent outline-none py-2.5 text-[15px] text-white placeholder:text-slate-500"
          />
        </label>
        <label class="block">
          <span class="sr-only">Subject</span>
          <input
            required
            type="text"
            name="subject"
            placeholder="Subject"
            class="w-full bg-transparent border-b border-white/20 focus:border-accent outline-none py-2.5 text-[15px] text-white placeholder:text-slate-500"
          />
        </label>
        <label class="block">
          <span class="sr-only">Message</span>
          <textarea
            required
            name="message"
            rows="5"
            placeholder="Message"
            class="w-full bg-transparent border-b border-white/20 focus:border-accent outline-none py-2.5 text-[15px] text-white placeholder:text-slate-500 resize-y"
          ></textarea>
        </label>
        <button type="submit" class="flat-button !text-[0.75rem] !px-4 !py-2.5">Send message</button>
      </form>

      <div class="rounded-xl overflow-hidden border border-accent/20">
        <iframe
          title="Zahraa Nasr City, Cairo"
          src="https://www.google.com/maps?q=Zahraa+Nasr+City,+Nasr+City,+Cairo+Governorate&output=embed"
          width="100%"
          height="176"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
