---
import { PERSONAL_INFO } from '../data/portfolio-data';

function letters(text: string, startDelay: number) {
  return [...text].map((char, i) => ({
    char: char === ' ' ? '\u00a0' : char,
    delay: `${(startDelay + i) * 0.08}s`,
  }));
}

const hi = letters('Hi,', 4);
const im = letters("I'm", 8);
const name = letters(PERSONAL_INFO.name.slice(1), 12);
const job = letters(PERSONAL_INFO.title, 22);
---

<section class="relative min-h-[calc(100vh-4rem)] md:min-h-screen flex items-center px-6 sm:px-12 lg:px-20 py-16">
  <div class="w-full max-w-[1400px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-7">
      <p class="page-tags mb-6" aria-hidden="true">&lt;h1&gt;</p>
      <h1 class="font-display text-6xl sm:text-7xl lg:text-[5.75rem] leading-[1.02] font-medium text-white">
        <span class="block">
          {hi.map((item) => (
            <span class="letter" style={`animation-delay: ${item.delay}`}>{item.char}</span>
          ))}
        </span>
        <span class="block mt-1">
          {im.map((item) => (
            <span class="letter" style={`animation-delay: ${item.delay}`}>{item.char}</span>
          ))}
          <span class="inline-flex items-center justify-center mx-2 w-14 h-14 sm:w-16 sm:h-16 rounded-md border border-accent text-accent font-display text-4xl sm:text-5xl align-middle">A</span>
          {name.map((item) => (
            <span class="letter" style={`animation-delay: ${item.delay}`}>{item.char}</span>
          ))}
        </span>
        <span class="block mt-1 text-accent">
          {job.map((item) => (
            <span class="letter" style={`animation-delay: ${item.delay}`}>{item.char}</span>
          ))}
        </span>
      </h1>
      <p class="page-tags mt-4" aria-hidden="true">&lt;/h1&gt;</p>

      <p class="fade-in-late mt-6 text-sm sm:text-base tracking-[0.28em] uppercase text-[#8d8d8d]">
        Streaming Pipelines | Medallion Warehouses | ELT / ETL
      </p>
      <p class="fade-in-late mt-4 max-w-2xl text-[17px] sm:text-lg text-slate-300 leading-relaxed">
        {PERSONAL_INFO.tagline}
      </p>

      <a href="/contact" class="flat-button fade-in-late mt-8">Contact me</a>
    </div>

    <div class="lg:col-span-5 flex justify-center lg:justify-end fade-in-late">
      <div class="stage-cube" aria-hidden="true">
        <div class="cubespinner">
          <div class="face1">Python</div>
          <div class="face2">SQL</div>
          <div class="face3">Kafka</div>
          <div class="face4">Snowflake</div>
          <div class="face5">dbt</div>
          <div class="face6">Airflow</div>
        </div>
      </div>
    </div>
  </div>
</section>
